# Lab Agent CLI configuration example.
#
# `lab setup` writes the real file to ~/.lab-agent/.env with restricted
# permissions. Never commit a real key. This file is only a reference.

# DeepSeek (default)
DEEPSEEK_API_KEY=sk-your-key-here
BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash

# Anthropic official (use one provider block at a time)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# BASE_URL=https://api.anthropic.com
# MODEL=claude-sonnet-5-5

# Any Anthropic-compatible endpoint
# ANTHROPIC_AUTH_TOKEN=your-token
# BASE_URL=https://your-provider.example.com
# MODEL=your-model

# Optional
# LAB_AGENT_HOME=/absolute/path/to/profile
# LAB_ENGINE_PATH=/absolute/path/to/lab-engine
# LAB_SECURITY_URL=https://example.com/security

# Privacy defaults (already set by the launcher)
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_TELEMETRY=1
